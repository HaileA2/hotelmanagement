# Database Configuration
DB_HOST=localhost
DB_NAME=hotel_management
DB_USER=root
DB_PASS=

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ISSUER=hotel-management-system
JWT_AUDIENCE=hotel-management-client
JWT_EXPIRE=86400  # 24 hours

# External API Configuration

# Tour Service API
TOUR_API_BASE_URL=https://api.tourservice.com/v1
TOUR_API_KEY=demo-api-key

# (Hotel/Booking external API support has been removed.)

# Restaurant Service API
RESTAURANT_API_BASE_URL=https://api.restaurantservice.com/v1
RESTAURANT_API_KEY=your_restaurant_api_key_here

# Taxi Service API
TAXI_API_BASE_URL=https://api.taxiservice.com/v1
TAXI_API_KEY=your_taxi_api_key_here

# Email Configuration (for sending confirmations)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASS=your_email_password
SMTP_FROM=no-reply@hotel-management.com

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/hotel-management-system
